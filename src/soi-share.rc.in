// Configured by CMakeLists.txt into the build directory. Resource ids must match
// app/Lifecycle.h.
#include <winver.h>

101 RCDATA "@SOI_SOURCE_DIR@/viewer/viewer.html"
102 RCDATA "@SOI_SOURCE_DIR@/THIRD_PARTY_NOTICES.md"

1 VERSIONINFO
FILEVERSION     @SOI_VERSION_MAJOR@,@SOI_VERSION_MINOR@,@SOI_VERSION_PATCH@,0
PRODUCTVERSION  @SOI_VERSION_MAJOR@,@SOI_VERSION_MINOR@,@SOI_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "soi-share - serverless P2P screen sharing"
            VALUE "FileVersion",      "@SOI_VERSION@"
            VALUE "InternalName",     "soi-share"
            VALUE "OriginalFilename", "soi-share.exe"
            VALUE "ProductName",      "soi-share"
            VALUE "ProductVersion",   "@SOI_VERSION@"
            VALUE "LegalCopyright",   "Third-party notices: soi-share licenses"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
